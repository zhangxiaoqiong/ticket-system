# 应用配置
app_name="地址诊断工单系统"
base_url="http://127.0.0.1:8000"

# 数据库配置
database_url="mysql+pymysql://user:password@host:3306/ticket_system?charset=utf8mb4"

# 机器人配置
robot_webhook_url=""
robot_enabled=true
