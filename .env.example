# 应用配置
app_name=顺心分单诊断工单系统
base_url=http://127.0.0.1:8000
app_base_path=

# 数据库配置
database_url=mysql+pymysql://root:password@127.0.0.1:3306/ticket_mvp?charset=utf8mb4

# 钉钉机器人配置
# 创建工单时不发钉钉（只用丰声Next通知运营群），所以这里可以关闭或留空。
robot_enabled=false
robot_webhook_url=
robot_webhook_map=
robot_proxy_url=
# 运营处理完成后通知用户反馈群并 @ 反馈人：robot_processed_webhook_map 优先按 reporterGroup/reporter_group 群ID匹配，reporterGroupName/reporter_group_name 群名兜底。
robot_processed_notify_enabled=true
robot_processed_webhook_url=https://oapi.dingtalk.com/robot/send?access_token=user_default_token
robot_processed_webhook_map={"group_id_jiujiang":"https://oapi.dingtalk.com/robot/send?access_token=user_jiujiang_token","group_id_hainan":"https://oapi.dingtalk.com/robot/send?access_token=user_hainan_token","default":"https://oapi.dingtalk.com/robot/send?access_token=user_default_token"}
robot_processed_statuses=RESOLVED
# 不走代理留空；需要代理时填写：http://10.215.18.77:80
robot_proxy_url=
# 可选：额外固定 @ 或按反馈群/用户工号配置 @；默认会 @ reporterAccount/channelUserId 和明细 notifyUserIds。
robot_at_mobiles=
robot_at_user_ids=
robot_at_map=

# 丰声 Next 消息配置
fs_next_enabled=true
fs_next_client_id=
fs_next_client_secret=
fs_next_group_ids=
fs_next_group_map=
fs_next_template_code=1312
fs_next_send_url=https://fs-next-api.sf-express.com/ump-biz/platform/send
fs_next_token_url=https://fs-next-api.sf-express.com/oauth2/token
fs_next_verify_ssl=true
