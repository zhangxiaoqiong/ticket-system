# 应用配置
app_name=顺心分单诊断工单系统
base_url=http://127.0.0.1:8000
app_base_path=

# 数据库配置
database_url=mysql+pymysql://root:password@127.0.0.1:3306/ticket_mvp?charset=utf8mb4

# 钉钉机器人配置
# 单运营群：只填 robot_webhook_url。
# 多反馈群：填 robot_webhook_map，key 优先匹配 reporterGroup/reporter_group，default 作为兜底群。
robot_enabled=true
robot_webhook_url=https://oapi.dingtalk.com/robot/send?access_token=default_token
robot_webhook_map={"九江反馈群":"https://oapi.dingtalk.com/robot/send?access_token=jiujiang_token","海南反馈群":"https://oapi.dingtalk.com/robot/send?access_token=hainan_token","default":"https://oapi.dingtalk.com/robot/send?access_token=default_token"}
# 不走代理留空；需要代理时填写：http://10.215.18.77:80
robot_proxy_url=
robot_processed_notify_enabled=true
robot_processed_statuses=RESOLVED
robot_at_mobiles=
robot_at_user_ids=
robot_at_map=

# 丰声 Next 消息配置
fs_next_enabled=true
fs_next_client_id=
fs_next_client_secret=
fs_next_group_ids=
fs_next_group_map=
fs_next_template_code=1312
fs_next_send_url=https://fs-next-api.sf-express.com/ump-biz/platform/send
fs_next_token_url=https://fs-next-api.sf-express.com/oauth2/token
fs_next_verify_ssl=true
